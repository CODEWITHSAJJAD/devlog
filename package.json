{
  "name": "devlog",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.13",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply devlog-db --local",
    "db:seed": "wrangler d1 execute devlog-db --local --file=./db/seed.sql",
    "pages:dev": "wrangler pages dev --compatibility-date=2024-01-01 --d1=DB=devlog-db"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@types/bcryptjs": "^2.4.6",
    "autoprefixer": "^10.6.2",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.154.0"
  }
}
